{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "ES2022.Error"],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["electron/**/*", "src/constants/**/*", "preload/**/*"],
  "exclude": ["node_modules"]
}
