{
  "name": "kone-system",
  "version": "1.4.38",
  "description": "Kone AI - B2B 智能获客与线索管理系统",
  "author": "Kone Team",
  "main": "dist-electron/electron/main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "clean": "if exist .vite rmdir /s /q .vite & if exist dist rmdir /s /q dist & if exist dist-electron rmdir /s /q dist-electron & if exist release rmdir /s /q release",
    "dev": "taskkill /f /im electron.exe /t 2>nul & concurrently \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && ping -n 3 127.0.0.1 >nul && npm run build:electron:dev && node launch-electron.cjs\"",
    "build": "npm run clean && rimraf --glob \"release/*\" && vite build && npm run build:electron",
    "bundle:preload": "esbuild preload/index.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist-electron/preload/index.js",
    "build:electron:dev": "tsc -p tsconfig.electron.json && npm run bundle:preload",
    "build:electron": "tsc -p tsconfig.electron.json && npm run bundle:preload && node --max-old-space-size=16384 scripts/obfuscate.cjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:alt": "vite build && npm run build:electron && electron-builder --win nsis -c.directories.output=release-build",
    "test:smoke:alt": "npm run dist:alt && node ./scripts/packaged-smoke.cjs release-build",
    "dist:signed": "vite build && npm run build:electron && electron-builder --win nsis --config electron-builder.sign.cjs",
    "verify:signature": "node ./scripts/verify-signature.cjs",
    "preview": "vite preview",
    "license:offline": "node ./scripts/generate-offline-license.cjs",
    "test": "npm run verify:consistency && npm run verify:release-gate && npm run test:unit && npm run test:cloud && npm run test:ipc && npm run test:e2e-smoke",
    "test:cloud": "cd kone-cloud && npx vitest run",
    "verify:docs": "node scripts/verify-doc-consistency.cjs",
    "verify:ipc": "node scripts/verify-ipc-consistency.cjs",
    "verify:cloud-safety": "node scripts/verify-cloud-safety.cjs",
    "verify:release-gate": "node scripts/verify-release-gate.cjs",
    "verify:consistency": "npm run verify:docs && npm run verify:ipc && npm run verify:cloud-safety",
    "test:unit": "npm run build:electron:dev && node --test --test-concurrency=1 tests/**/*.test.{js,ts}",
    "test:coverage": "npm run build:electron:dev && node --test --experimental-test-coverage --test-coverage-exclude=tests/** --test-coverage-exclude=node_modules/** --test-coverage-lines=65 --test-coverage-branches=60 --test-coverage-functions=64 --test-concurrency=1 tests/**/*.test.{js,ts}",
    "test:ipc": "npm run build:electron:dev && node --test tests/ipc-contract-sweep.test.ts",
    "test:e2e": "npm run build:electron:dev && node --test tests/e2e/fallback-routing.test.js",
    "test:e2e-journey": "npm run build:electron:dev && node --test tests/e2e-journey.test.js",
    "test:e2e-smoke": "npm run build:electron:dev && node --test tests/e2e/permission-lock.test.js",
    "test:visual": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && node scripts/probe-visual-all.cjs\"",
    "test:visual:tokens": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && node scripts/probe-design-tokens.cjs\"",
    "test:gateway": "npm run build:electron:dev && node --test tests/license-gateway.test.js",
    "test:env": "npm run build:electron:dev && node --test tests/env-isolation.test.ts",
    "test:bypass": "npm run build:electron:dev && node --test tests/dev-bypass.test.ts",
    "test:all": "npm run build:electron:dev && node --test tests/*.test.{js,ts} tests/e2e/*.test.js tests/e2e/*.test.ts 2>&1",
    "test:smoke": "npm run dist && node ./scripts/packaged-smoke.cjs",
    "test:first-run": "node ./scripts/packaged-first-run.cjs",
    "test:packaged-premium": "npm run dist && node ./scripts/verify-packaged-premium.cjs",
    "test:security-audit": "npm run test:gateway && npm run test:env && npm run test:bypass && node ./scripts/security-audit.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\" \"tests/**/*.{js,ts}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\" \"tests/**/*.{js,ts}\"",
    "format": "prettier --check \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\" \"tests/**/*.{js,ts}\"",
    "format:fix": "prettier --write \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\" \"tests/**/*.{js,ts}\"",
    "prepare": "husky"
  },
  "build": {
    "appId": "ai.kone.desktop",
    "productName": "Kone AI",
    "artifactName": "Kone-Intellect-Setup-${version}.${ext}",
    "executableName": "KoneAI",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*",
      "package.json",
      "!**/*.pem",
      "!.opencode",
      "!.opencode/**",
      "!tests",
      "!tests/**",
      "!**/*.test.ts"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "artifactName": "Kone-Intellect-Setup-${version}.${ext}",
      "shortcutName": "Kone 智能获客"
    },
    "publish": null
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "electron-updater": "^6.8.9",
    "imapflow": "1.0.191",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^8.0.10",
    "puppeteer": "^23.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^20.19.37",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "autoprefixer": "^10.4.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "^33.3.2",
    "electron-builder": "^26.8.1",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "javascript-obfuscator": "^4.1.0",
    "lint-staged": "^17.0.7",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.4",
    "puppeteer-core": "^23.11.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "rimraf": "^6.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4",
    "zustand": "^5.0.11"
  }
}
