{
  "name": "kone-system",
  "version": "1.3.0-alpha",
  "description": "Kone AI - B2B 智能获客与线索管理系统",
  "author": "Kone Team",
  "main": "dist-electron/electron/main.js",
  "license": "MIT",
  "scripts": {
    "clean": "if exist .vite rmdir /s /q .vite & if exist dist rmdir /s /q dist & if exist dist-electron rmdir /s /q dist-electron & if exist release rmdir /s /q release",
    "dev": "taskkill /f /im electron.exe /t 2>nul & concurrently \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && ping -n 3 127.0.0.1 >nul && npm run build:electron:dev && node launch-electron.cjs\"",
    "build": "npm run clean && rimraf --glob \"release/*\" && vite build && npm run build:electron",
    "build:electron:dev": "tsc -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json && node --max-old-space-size=16384 scripts/obfuscate.cjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "preview": "vite preview",
    "license:offline": "node ./scripts/generate-offline-license.cjs",
    "test": "node --test tests/**/*.test.{js,ts}",
    "test:e2e": "npm run build:electron:dev && node --test tests/e2e/fallback-routing.test.js",
    "test:e2e-journey": "npm run build:electron:dev && node --test tests/e2e-journey.test.js",
    "test:mock-search-fallback": "npm run build:electron:dev && node tests/mock-search-fallback.js",
    "test:circuit-breaker": "npm run build:electron:dev && node --test tests/circuit-breaker.test.js",
    "test:gateway": "npm run build:electron:dev && node --test tests/license-gateway.test.js",
    "test:smoke": "npm run dist && node ./scripts/packaged-smoke.cjs",
    "test:security-audit": "npm run dist && node ./scripts/security-audit.cjs"
  },
  "build": {
    "appId": "ai.kone.desktop",
    "productName": "Kone AI",
    "artifactName": "Kone-Intellect-Setup-${version}.${ext}",
    "executableName": "KoneAI",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.pem",
      "!.opencode",
      "!.opencode/**",
      "!tests",
      "!tests/**",
      "!**/*.test.ts"
    ],
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "artifactName": "Kone-Intellect-Setup-${version}.${ext}",
      "shortcutName": "Kone 智能获客"
    },
    "publish": null
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^8.0.10"
  },
  "devDependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^20.19.37",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "autoprefixer": "^10.4.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "^33.3.2",
    "electron-builder": "^26.8.1",
    "javascript-obfuscator": "^4.1.0",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.8",
    "puppeteer": "^23.11.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "rimraf": "^6.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4",
    "zustand": "^5.0.11"
  }
}
