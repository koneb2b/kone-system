{
    "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/master/assets/oh-my-opencode.schema.json",
    "sisyphus": {
      "max_concurrent_tasks": 2,
      "model": "amux/gpt-5.4"
    },
    "agents": {
      "prometheus": { "model": "amux/gpt-5.4" },
      "atlas": { "model": "amux/gpt-5.4" },
      "hephaestus": { "model": "amux/gpt-5.4" },
      "oracle": { "model": "amux/gpt-5.4" },
      "momus": { "model": "amux/gpt-5.4" },
      "metis": { "model": "amux/gpt-5.4", "temperature": 0.3 }
    },
    "categories": {
      "visual-engineering": { "model": "amux/gpt-5.4" },
      "deep": { "model": "amux/gpt-5.3-codex" },
      "quick": { "model": "amux/gpt-5.4" }
    }
  }